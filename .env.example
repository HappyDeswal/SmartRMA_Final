# SmartRMA uses installed local Ollama models only. Cloud keys are ignored.
# Start: OLLAMA_NO_CLOUD=1 ollama serve
# Primary vision: qwen3-vl:8b; fallback: llama3.2-vision:latest, moondream:latest
# Primary chat: qwen2.5:7b; local fallback models are listed in node/local_runtime.py
# Optional isolated storage for testing (set in the shell, not loaded from this file):
# SMARTRMA_DATA_DIR=/tmp/smartrma-verification-data python3 run.py --no-browser
