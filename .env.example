# Configuration is read from shell environment variables; this file is a reference.
# Local inference only: OLLAMA_NO_CLOUD=1 ollama serve
# Primary models: qwen3-vl:8b (vision), qwen2.5:7b (text).
# Start the three nodes: python3 run.py
HAPPY_ORIGIN=http://127.0.0.1:8010
HAPPY_LOCAL_AUTO_LOGIN=1
# Optional: absolute dedicated private data directory (default: ./var).
# HAPPY_DATA_DIR=/absolute/path/to/private-data
# Optional local trained classifier directory (default: ./var/models/hardware).
# HAPPY_HARDWARE_MODEL_DIR=/absolute/path/to/model
